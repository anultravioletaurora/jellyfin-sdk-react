{
  "name": "@jellyfin/sdk-react",
  "version": "0.0.1",
  "description": "An SDK for performing Jellyfin operations in a React Native app",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "jellyfin-sdk-react-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "npm run --workspace @jellyfin/sdk-react-example --",
    "example:start": "npm run start --workspace @jellyfin/sdk-react-example --",
    "example:ios": "npm run ios --workspace @jellyfin/sdk-react-example --",
    "example:pod:install": "cd example/ios && bundle exec pod install",
    "example:android": "npm run android --workspace @jellyfin/sdk-react-example --",
    "clean": "rm -rf android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "format": "prettier --write .",
    "test": "jest"
  },
  "keywords": [
    "jellyfin",
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anultravioletaurora/jellyfin-sdk-react.git"
  },
  "author": "Violet Caulfield <violet@cosmonautical.cloud> (https://github.com/anultravioletaurora)",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/anultravioletaurora/jellyfin-sdk-react/issues"
  },
  "homepage": "https://github.com/anultravioletaurora/jellyfin-sdk-react#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "jest": "29.7.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "0.44.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "overrides": {
    "eslint-plugin-ft-flow": "^3.0.11"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">= 22.11.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "SdkReactSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.jellyfin.sdkreact"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.64.0"
  }
}
